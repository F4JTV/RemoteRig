// Icone et metadonnees de l'executable (Windows uniquement).
#include <windows.h>

IDI_ICON1 ICON "../icons/remoterig-client.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "RemoteRig Project"
            VALUE "FileDescription",  "RemoteRig — Remote operator console"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "remoterig-client"
            VALUE "LegalCopyright",   "MIT licence"
            VALUE "OriginalFilename", "remoterig-client.exe"
            VALUE "ProductName",      "RemoteRig Client"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
